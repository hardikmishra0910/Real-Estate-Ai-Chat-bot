{"chunk_id": "db6db137de38ef61402af0ca9c29c416_0", "parent_id": "db6db137de38ef61402af0ca9c29c416", "source": "darglobal", "source_url": "https://darglobal.co.uk/projects/properties-in-uae", "title": "DarGlobal Properties in UAE — Dubai & Ras Al Khaimah", "doc_type": "project", "location": "UAE — Dubai & Ras Al Khaimah", "content": "DarGlobal offers a range of luxury properties in the UAE, primarily in Dubai and Ras Al Khaimah (RAK). Property types include luxury apartments, villas, and hotel residences. Dubai projects include the DaVinci Tower by Pagani. Ras Al Khaimah is an emerging luxury investment destination where DarGlobal is developing world-class projects with waterfront residences and high-end lifestyle amenities. DarGlobal describes RAK as a premier hub for global investors with a mix of breathtaking natural settings, beachfront properties, high rental yields, and long-term appreciation potential.", "chunk_index": 0, "total_chunks": 1, "scraped_at": "2026-11-18T10:46:11.901058+00:00"}
{"chunk_id": "3880c87dc0b15a55ecc1018f70cba4ef_0", "parent_id": "3880c87dc0b15a55ecc1018f70cba4ef", "source": "darglobal", "source_url": "https://darglobal.co.uk/projects/properties-in-qatar", "title": "DarGlobal Properties in Qatar", "doc_type": "project", "location": "Qatar", "content": "DarGlobal offers luxury properties in Qatar, including villa and apartment developments. Qatar's freehold zones — The Pearl, Lusail, and West Bay Lagoon — allow foreign ownership under Decision No. 28 of 2020. These areas offer full ownership rights enabling expats to buy, sell, and lease without restrictions. DarGlobal's Qatar portfolio is part of its broader Gulf region expansion strategy.", "chunk_index": 0, "total_chunks": 1, "scraped_at": "2026-11-18T10:46:11.901058+00:00"}
{"chunk_id": "9ebdc3665a2ff37fee391389b54e4191_0", "parent_id": "9ebdc3665a2ff37fee391389b54e4191", "source": "darglobal", "source_url": "https://darglobal.co.uk/partners/trump", "title": "DarGlobal Partnership — Trump Organization", "doc_type": "partnership", "location": "Saudi Arabia, Oman", "content": "Dar Global has an extensive partnership with The Trump Organization for branded luxury developments across the Middle East. Projects include: Trump Tower Jeddah (launched December 2024, Jeddah, Saudi Arabia), Trump Plaza Jeddah (launched January 2026, GDV USD 383.6 million), and Trump International Oman at AIDA (Muscat, Oman). These Trump-branded properties combine DarGlobal's development expertise with the Trump brand's global recognition in luxury real estate.", "chunk_index": 0, "total_chunks": 1, "scraped_at": "2026-11-18T10:46:11.901058+00:00"}
{"chunk_id": "29271ff2012af4f45ae4c42d37d8823a_0", "parent_id": "29271ff2012af4f45ae4c42d37d8823a", "source": "darglobal", "source_url": "https://darglobal.co.uk/partners/lamborghini", "title": "DarGlobal Partnership — Aston Martin & Lamborghini", "doc_type": "partnership", "location": "Spain, UAE", "content": "Dar Global collaborates with iconic luxury automotive brands to create uniquely designed residences. The Aston Martin partnership produces branded residences with Aston Martin's signature design language applied to interior architecture and amenities. The Lamborghini (Automobili Lamborghini) partnership produced Tierra Viva — a luxury villa development in Spain. These partnerships are part of DarGlobal's House of Brands strategy, fusing automotive design prestige with premium real estate.", "chunk_index": 0, "total_chunks": 1, "scraped_at": "2026-11-18T10:46:11.901058+00:00"}
{"chunk_id": "a8841370a1321c61912f709037dafc55_0", "parent_id": "a8841370a1321c61912f709037dafc55", "source": "darglobal", "source_url": "https://darglobal.co.uk/about", "title": "DarGlobal — Luxury Branded Residences Strategy", "doc_type": "company", "location": "Global", "content": "Dar Global's international portfolio spans exquisite residences, vacation retreats, world-class hospitality, and developments with iconic luxury brands including Aston Martin and Lamborghini. The company's approach combines Design, Lifestyle, and Investment Value in every property. DarGlobal targets global citizens who want to live without borders. Its properties are strategically located in established and emerging markets including Dubai, Jeddah, Muscat, Doha, London, and Spain. DarGlobal's total project pipeline reached USD 19 billion in 2026. The company is built on 31 years of luxury development experience through its parent company Dar Al Arkan.", "chunk_index": 0, "total_chunks": 1, "scraped_at": "2026-11-18T10:46:11.901058+00:00"}
