# ============================================================
# EstateIQ — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- OpenRouter ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-3-4b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
SECRET_KEY=change_this_to_a_long_random_string_in_production

# --- CORS ---
FRONTEND_URL=http://localhost:3000

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_DARGLOBAL=darglobal_docs
CHROMA_COLLECTION_WASALT=wasalt_docs

# --- Scraping ---
SCRAPE_DELAY_SECONDS=2
MAX_PAGES_PER_SITE=50

# --- RAG ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
